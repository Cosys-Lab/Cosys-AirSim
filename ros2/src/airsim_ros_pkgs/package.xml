<?xml version='1.0' encoding='utf-8'?>
<package format="3">
  <name>airsim_ros_pkgs</name>
  <version>4.0.0</version>
  <description>ROS Wrapper over Cosys-AirSim's C++ client library</description>

  <maintainer email="wouter.jansen@uantwerpen.be">Wouter Jansen</maintainer>

  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- every find_package in CMakeLists.txt, so rosdep installs all of them -->
  <depend>airsim_interfaces</depend>
  <depend>builtin_interfaces</depend>
  <depend>cv_bridge</depend>
  <depend>geographic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>image_transport</depend>
  <depend>mavros_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_sensor_msgs</depend>
  <!-- system libraries -->
  <depend>libopencv-dev</depend>
  <depend>libpcl-all-dev</depend>
  <depend>yaml-cpp</depend>

  <exec_depend>joy</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
